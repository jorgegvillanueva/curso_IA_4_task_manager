{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run test)",
      "Bash(npm run format)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log)"
    ],
    "ask": ["Bash(git push *)", "Bash(npm install *)"],
    "deny": ["Read(./.env)", "Bash(gh pr merge *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/formatear.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
